{
  "name": "@ripwords/myinvois-client",
  "version": "0.5.0",
  "description": "MyInvois client",
  "license": "MIT",
  "scripts": {
    "build": "tsdown",
    "verify-dist": "bun run scripts/verify-dist.ts",
    "prepublishOnly": "rm -rf dist && bun run build && bun run verify-dist",
    "lint": "oxlint",
    "test": "vitest",
    "test:run": "vitest run",
    "release": "bun run scripts/release.ts patch",
    "release:minor": "bun run scripts/release.ts minor",
    "release:major": "bun run scripts/release.ts major"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "type": "module",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/qrcode": "^1.5.5",
    "changelogen": "^0.6.1",
    "dotenv": "^16.5.0",
    "oxlint": "^0.16.6",
    "prettier": "^3.5.3",
    "qrcode": "^1.5.4",
    "tsdown": "^0.12.6",
    "vitest": "^3.1.1"
  },
  "peerDependencies": {
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "crypto": "^1.0.1",
    "node-forge": "^1.3.1"
  }
}
