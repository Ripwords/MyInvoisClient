{
  "name": "@ripwords/myinvois-client",
  "version": "0.6.0",
  "description": "TypeScript client for Malaysia's MyInvois (LHDN) e-invoicing API — document building, XAdES signing, submission and rate limiting.",
  "license": "MIT",
  "scripts": {
    "build": "tsdown",
    "verify-dist": "bun run scripts/verify-dist.ts",
    "prepublishOnly": "rm -rf dist && bun run build && bun run verify-dist",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:integration": "RUN_INTEGRATION=true vitest run test/integration",
    "release": "bun run scripts/release.ts patch",
    "release:minor": "bun run scripts/release.ts minor",
    "release:major": "bun run scripts/release.ts major"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "type": "module",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./codes": {
      "import": {
        "types": "./dist/codes/index.d.ts",
        "default": "./dist/codes/index.js"
      },
      "require": {
        "types": "./dist/codes/index.d.cts",
        "default": "./dist/codes/index.cjs"
      }
    }
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node-forge": "^1.3.14",
    "@types/qrcode": "^1.5.5",
    "changelogen": "^0.6.1",
    "dotenv": "^16.5.0",
    "oxlint": "^0.16.6",
    "prettier": "^3.5.3",
    "qrcode": "^1.5.4",
    "tsdown": "^0.12.6",
    "vitest": "^3.1.1"
  },
  "peerDependencies": {
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "node-forge": "^1.3.1"
  },
  "author": "Jia Jing Teoh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ripwords/MyInvoisClient.git"
  },
  "homepage": "https://github.com/Ripwords/MyInvoisClient#readme",
  "bugs": {
    "url": "https://github.com/Ripwords/MyInvoisClient/issues"
  },
  "keywords": [
    "myinvois",
    "lhdn",
    "e-invoice",
    "einvoice",
    "malaysia",
    "tax",
    "ubl",
    "xades",
    "typescript",
    "sdk"
  ],
  "engines": {
    "node": ">=18"
  }
}
