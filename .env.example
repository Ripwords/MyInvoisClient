# Copy to .env and fill in. Never commit real values.

# API credentials from the MyInvois portal (sandbox)
MYINVOIS_CLIENT_ID=
MYINVOIS_CLIENT_SECRET=

# PKCS#12 signing certificate — single source of certificate + private key
MYINVOIS_P12_PATH=path/to/certificate.p12
MYINVOIS_P12_PASSPHRASE=

# Supplier identity (must match the certificate holder)
MYINVOIS_SUPPLIER_NAME=
MYINVOIS_SUPPLIER_TIN=
# BRN for companies, NRIC for individuals
MYINVOIS_SUPPLIER_ID_TYPE=BRN
MYINVOIS_SUPPLIER_ID_VALUE=

# Set to true to enable the live sandbox integration suite (test/integration)
# RUN_INTEGRATION=true
